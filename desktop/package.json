{
  "name": "handshake-desktop",
  "productName": "Handshake",
  "version": "1.3.0",
  "description": "Private, end-to-end encrypted video meetings. No accounts.",
  "main": "main.js",
  "author": "Handshake contributors",
  "homepage": "https://github.com/CS-Fasih/E2EE-meeting",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "scripts": {
    "copy-web": "node ../scripts/copy-web.cjs app",
    "start": "npm run copy-web && electron .",
    "dist:win": "npm run copy-web && electron-builder --win portable --x64 --publish never && node ../scripts/build-installer.cjs",
    "dist:linux": "npm run copy-web && electron-builder --linux deb AppImage --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "26.18.0",
    "resedit": "3.1.1"
  },
  "build": {
    "appId": "app.handshake.desktop",
    "productName": "Handshake",
    "copyright": "Copyright (c) 2026 CS-Fasih and Handshake contributors. Free for non-commercial use.",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "app/**/*",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "../LICENSE",
        "to": "LICENSE.txt"
      }
    ],
    "asar": true,
    "electronLanguages": [
      "en-US"
    ],
    "protocols": [
      {
        "name": "Handshake meeting link",
        "schemes": [
          "handshake"
        ]
      }
    ],
    "afterPack": "./build/after-pack.cjs",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Handshake-${version}-portable.exe"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Network",
      "icon": "build/icons",
      "executableName": "handshake",
      "maintainer": "CS-Fasih <132261661+CS-Fasih@users.noreply.github.com>",
      "vendor": "Handshake contributors",
      "synopsis": "Private, end-to-end encrypted video meetings",
      "description": "Group video calls, screen sharing and chat, end-to-end encrypted, with no accounts and no central server.",
      "artifactName": "Handshake-${version}-${arch}.${ext}"
    },
    "deb": {
      "artifactName": "handshake_${version}_amd64.${ext}",
      "packageCategory": "net",
      "priority": "optional",
      "packageName": "handshake"
    },
    "publish": null
  }
}
